+// SUBS or MOVS into the PC from the BIOS's exception code: the CPSR comes back from the SPSR and
+// compiled code refills itself; the exact CPU runs it only when an IRQ is waiting.
+static void emitReturn(struct Compiler* c, const struct Inst* in) {
+	struct Emitter* e = &c->e;
+	spill(c);
+	xLoad(e, 4, RAX, M(R15, REG(14)));
+	if (in->op == ALU_SUB) {
+		xAluI(e, X_SUB, 4, R(RAX), (int32_t) in->op2.imm);
+	}
+	xStore(e, 4, M(R15, REG(15)), RAX);
+	xMovRR(e, 8, RDI, R15);
+	callAbs(e, jitHelperReturn);
+	xCall(e, c->jit->reloadRoutine);
+	xAluI(e, X_CMP, 4, R(RAX), -1);
+	uint8_t* exact = xJcc(e, CC_E, NULL);
+	emitIndirect(c, in, c->jit->dispatchBx);
+	patchHere(e, exact);
+	emitSystem(c, in);
+}
