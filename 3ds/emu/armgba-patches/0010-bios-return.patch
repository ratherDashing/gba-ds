diff --git a/src/cpu/jit.c b/src/cpu/jit.c
index 00e5448..515ac56 100644
--- a/src/cpu/jit.c
+++ b/src/cpu/jit.c
@@ -2713,6 +2713,16 @@ bool jitSystem(const struct Inst* in) {
 	}
 }
 
+bool jitIsReturn(const struct Inst* in) {
+	if (in->kind != I_ALU || in->thumb || in->cond != COND_AL || in->rd != 15 || !in->setFlags || in->poly || in->patchable) {
+		return false;
+	}
+	if (in->op == ALU_SUB) {
+		return in->rn == 14 && in->op2.isImm;
+	}
+	return in->op == ALU_MOV && !in->op2.isImm && in->op2.rm == 14 && in->op2.type == SHIFT_LSL && !in->op2.amount && !in->op2.byReg;
+}
+
 // Returns the key of the block at the PC in the CPU state.
 static uint32_t currentKey(struct GBA* gba) {
 	bool thumb = gba->cpu.cpsr & PSR_T;
@@ -2804,6 +2814,21 @@ uint32_t jitHelperSystem(struct GBA* gba, uint32_t opcode, uint32_t address) {
 	return currentKey(gba);
 }
 
+// SUBS or MOVS into the PC from a mode with an SPSR, the target in r15: restores the CPSR and returns
+// the target with the new instruction set in bit 0, or ~0, with nothing done, for the exact CPU to run.
+uint32_t jitHelperReturn(struct GBA* gba) {
+	struct CPU* cpu = &gba->cpu;
+	uint32_t spsr = cpu->spsr;
+	if (!cpuModeHasSpsr(cpu->cpsr & 0x1F) || (gba->irq.line && !(spsr & PSR_I))) {
+		return ~0u;
+	}
+	uint32_t target = cpu->r[15];
+	cpuWriteCpsr(gba, spsr);
+	cpu->irqMasked = spsr & PSR_I;
+	cpu->fetchSeq = true;
+	return (target & ~1u) | !!(spsr & PSR_T);
+}
