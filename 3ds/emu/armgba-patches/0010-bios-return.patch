 }
 
+// SUBS or MOVS into the PC from the BIOS's exception code: the CPSR comes back from the SPSR and
+// compiled code refills itself; the exact CPU runs it only when an IRQ is waiting.
+static void emitReturn(struct Compiler* c, const struct Inst* in) {
+	struct Emitter* e = &c->e;
+	clobberFlags(c);
+	flushPending(c);
+	ldrF(e, R0, REG(14));
+	if (in->op == ALU_SUB) {
+		aAddI(e, R0, R0, -(int32_t) in->op2.imm, R12);
+	}
+	strF(e, R0, REG(15));
+	aMov(e, R0, R_GBA);
+	callAbs(e, jitHelperReturn);
+	aCmpI(e, R0, -1, R3);
+	uint8_t* exact = aB(e, C_EQ, NULL);
+	ldrF(e, R_FLAGS, OFF(cpu.cpsr));
+	emitIndirect(c, in, c->jit->dispatchBx, false);
+	patchHere(e, exact);
+	emitSystem(c, in);
+}
+
 // BX to a register.
 static void emitBx(struct Compiler* c, const struct Inst* in) {
 	loadGuest(c, R0, in->rm, in);
@@ -2562,7 +2583,11 @@ static void emitBody(struct Compiler* c, const struct Inst* in, int index) {
