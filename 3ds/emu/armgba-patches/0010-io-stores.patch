+void gbaIrqQuietChanged(struct GBA* gba, bool wasQuiet) {
+	int32_t late = 0;
+	int leaving = wasQuiet && !gbaQuietHblank(gba) ? quietLeaving(gba, &late) : QUIET_LEAVE_PLAIN;
