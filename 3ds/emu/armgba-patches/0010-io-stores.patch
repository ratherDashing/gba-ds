-// Called after DISPSTAT's H-blank IRQ enable or IE changed. When leaving quiet mode, a request
-// under way continues as events: the IF update one cycle after an H-blank that just happened, or
-// the register's one cycle after that.
-void gbaIrqQuietChanged(struct GBA* gba, bool wasQuiet) {
+// What leaving quiet mode with a request under way has to do: its H-blank is this cycle (the request becomes an event
+// again), or was the last cycle or the one before (the register shows it a cycle later), or neither.
+enum { QUIET_LEAVE_PLAIN, QUIET_LEAVE_NOW, QUIET_LEAVE_JUST };
+
+static int quietLeaving(struct GBA* gba, int32_t* late) {
+	struct Irq* irq = &gba->irq;
+	if (!irq->quietPending) {
+		return QUIET_LEAVE_PLAIN;
+	}
+	uint32_t now = timingCurrentTime(gba);
+	uint32_t hblank = videoNextHblank(gba, irq->quietFrom);
+	*late = (int32_t) (now - (hblank + 2));
+	if (hblank == now) {
+		return QUIET_LEAVE_NOW;
+	}
+	return (int32_t) (now - hblank) > 0 && *late < 0 ? QUIET_LEAVE_JUST : QUIET_LEAVE_PLAIN;
+}
+
+// Called after DISPSTAT's H-blank IRQ enable or IE changed. When leaving quiet mode, a request under way continues as
+// events: the IF update one cycle after an H-blank that just happened, or the register's one cycle after that.
+// leaving and late are what quietLeaving said.
+static void quietChanged(struct GBA* gba, bool wasQuiet, int leaving, int32_t late) {
 	struct Irq* irq = &gba->irq;
 	bool quiet = gbaQuietHblank(gba);
 	if (quiet == wasQuiet) {
