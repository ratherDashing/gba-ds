 	}
-	cpuWriteCpsr(gba, cpsr);
+	return cpsr;
+}
+
+// MSR: writes the fields named in the mask; a change of mode switches the banked registers.
+void jitHelperMsr(struct GBA* gba, uint32_t value, uint32_t packed) {
+	struct CPU* cpu = &gba->cpu;
+	if (packed & 0x100) {
+		uint32_t mask = packed & 0xFF0000FF & (PSR_USER_MASK | PSR_PRIV_MASK | PSR_STATE_MASK);
+		cpu->spsr = (cpu->spsr & ~mask) | (value & mask) | 0x10;
+		return;
+	}
+	cpuWriteCpsr(gba, cpuMsrCpsr(cpu, value, packed));
 }
