+// MSR from compiled code, which leaves the guest's registers and flags in host registers: the new
+// PSR doesn't depend on them. Returns 1, with nothing done, when the exact CPU has to run it.
+uint32_t jitHelperPsrWrite(struct GBA* gba, uint32_t value, uint32_t packed) {
+	struct CPU* cpu = &gba->cpu;
+	if (packed & 0x100) {
+		jitHelperMsr(gba, value, packed);
+	} else {
+		uint32_t before = cpu->cpsr;
+		uint32_t after = cpuMsrCpsr(cpu, value, packed);
+		if (((before & PSR_I) && !(after & PSR_I) && gba->irq.line) || ((before ^ after) & PSR_T)) {
+			return 1;
+		}
+		cpuWriteCpsr(gba, after);
+	}
+	cpu->fetchSeq = true;
+	return 0;
+}
+
+// SUBS or MOVS into the PC from a mode with an SPSR, the target in r15: restores the CPSR and returns
+// the target with the new instruction set in bit 0, or ~0, with nothing done, for the exact CPU to run.
+uint32_t jitHelperReturn(struct GBA* gba) {
+	struct CPU* cpu = &gba->cpu;
+	uint32_t spsr = cpu->spsr;
+	if (!cpuModeHasSpsr(cpu->cpsr & 0x1F) || (gba->irq.line && !(spsr & PSR_I))) {
+		return ~0u;
+	}
+	uint32_t target = cpu->r[15];
+	cpuWriteCpsr(gba, spsr);
+	cpu->irqMasked = spsr & PSR_I;
+	cpu->fetchSeq = true;
+	return (target & ~1u) | !!(spsr & PSR_T);
+}
