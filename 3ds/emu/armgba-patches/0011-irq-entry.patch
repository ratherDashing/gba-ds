+// MSR without the exact CPU's decoding: the helper needs neither the guest's registers nor the
+// cycles, and a flag field's new flags are taken from the operand.
+static void emitMsr(struct Compiler* c, const struct Inst* in) {
+	struct Emitter* e = &c->e;
+	// A banked register may change under the operand with the mode, before its flags are read again.
+	bool const banked = !in->op2.isImm && in->op2.rm >= 8 && !in->spsr && in->fieldMask == 0xFF0000FF;
+	if (!in->op2.isImm && (in->op2.rm == 15 || banked)) {
+		emitSystem(c, in);
+		return;
+	}
+	storeHead(c, in->address + 3 * c->width);
+	clobberFlags(c);
+	flushPending(c);
+	if (in->op2.isImm) {
+		aMovI(e, R1, in->op2.imm);
+	} else {
+		loadGuest(c, R1, in->op2.rm, in);
+	}
+	aMovI(e, R2, in->fieldMask | (in->spsr ? 0x100 : 0));
+	aMov(e, R0, R_GBA);
+	callAbs(e, jitHelperPsrWrite);
+	aCmpI(e, R0, 0, R3);
+	uint8_t* exact = aB(e, C_NE, NULL);
+	if (!in->spsr && (in->fieldMask & 0xF0000000)) {
+		if (in->op2.isImm) {
+			aMovI(e, R_FLAGS, in->op2.imm & 0xF0000000);
+		} else {
+			aDpI(e, C_AL, D_AND, false, R_FLAGS, guestReg(c, in->op2.rm, in, R1), 0xF0000000);
+		}
+	}
+	emitLinkTo(c, in->address + c->width, c->thumb);
+	patchHere(e, exact);
+	emitSystem(c, in);
+}
+
+// SUBS or MOVS into the PC from the BIOS's exception code: the CPSR comes back from the SPSR and
+// compiled code refills itself; the exact CPU runs it only when an IRQ is waiting.
+static void emitReturn(struct Compiler* c, const struct Inst* in) {
+	struct Emitter* e = &c->e;
+	clobberFlags(c);
+	flushPending(c);
+	ldrF(e, R0, REG(14));
+	if (in->op == ALU_SUB) {
+		aAddI(e, R0, R0, -(int32_t) in->op2.imm, R12);
+	}
+	strF(e, R0, REG(15));
+	aMov(e, R0, R_GBA);
+	callAbs(e, jitHelperReturn);
+	aCmpI(e, R0, -1, R3);
+	uint8_t* exact = aB(e, C_EQ, NULL);
+	ldrF(e, R_FLAGS, OFF(cpu.cpsr));
+	emitIndirect(c, in, c->jit->dispatchBx, false);
+	patchHere(e, exact);
+	emitSystem(c, in);
+}
+
 // BX to a register.
 static void emitBx(struct Compiler* c, const struct Inst* in) {
 	loadGuest(c, R0, in->rm, in);
