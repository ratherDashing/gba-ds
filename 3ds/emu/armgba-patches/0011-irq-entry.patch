+// Whether an IRQ is waiting to be taken at the next instruction, with nothing else asking the exact
+// CPU to step it first.
+static bool irqEntry(struct GBA* gba) {
+	return gba->irq.line && !gba->cpu.irqMasked && !gba->traceFile && !gba->cartTrapped;
+}
+
+// Takes the IRQ that is waiting, and no more, so that compiled code runs the vector's branch. A frame
+// that ends inside the entry still ends after that branch.
+static void enterIrq(struct GBA* gba) {
+	stepTakeIrq(gba);
+	if (gba->video.frameCounter != gba->jit->frame || gba->returnRequested) {
+		stepInstruction(gba);
+	}
+}
