-// Frees every block and list, for a flush or at shutdown.
+// Memory that lives until the next flush, from chunks that go back together. A heap too full or too
+// cut up for a chunk gives what is asked for piece by piece, as malloc did before the chunks.
+void* jitAlloc(struct Jit* jit, size_t size) {
+	enum { CHUNK = 64 << 10, ALIGN = 8 };
+	size = (size + ALIGN - 1) & ~(size_t) (ALIGN - 1);
+	if (size > (size_t) (jit->arenaEnd - jit->arenaNext)) {
+		// A request that would waste much of a chunk has one to itself, behind the one being filled.
+		size_t take = size > CHUNK / 4 ? size : CHUNK;
+		struct ArenaChunk* chunk = malloc(sizeof(*chunk) + take + ALIGN);
+		if (!chunk && take > size) {
+			take = size;
+			chunk = malloc(sizeof(*chunk) + take + ALIGN);
+		}
+		if (!chunk) {
+			return NULL;
+		}
+		uint8_t* const start = (uint8_t*) (((uintptr_t) (chunk + 1) + ALIGN - 1) & ~(uintptr_t) (ALIGN - 1));
+		if (take == size && (size > CHUNK / 4 || jit->arena)) {
+			chunk->next = jit->arena ? jit->arena->next : NULL;
+			if (jit->arena) {
+				jit->arena->next = chunk;
+			} else {
+				jit->arena = chunk;
+				jit->arenaNext = jit->arenaEnd = start + size;
+			}
+			return start;
+		}
+		chunk->next = jit->arena;
+		jit->arena = chunk;
+		jit->arenaNext = start;
+		jit->arenaEnd = start + take;
+	}
+	void* const at = jit->arenaNext;
+	jit->arenaNext += size;
+	return at;
+}
