+// Moves up to count DMA units from EWRAM or IWRAM to I/O registers, timed as busDmaRead and busDmaWrite
+// would. Each unit's cycles are worked out again, as a register can be WAITCNT.
+int memoryDmaToIo(struct GBA* gba, struct Dma* dma, int count, bool wide, int32_t sourceStep, int32_t destStep) {
+	struct CPU* cpu = &gba->cpu;
+	const uint8_t* waits = wide ? gba->waitS32 : gba->waitS16;
+	uint32_t s = dma->nextSource;
+	uint32_t d = dma->nextDest;
+	int n = 0;
+	for (; n < count && !gba->dmaReenter; ++n) {
+		if ((s >> 24) < REGION_EWRAM || (s >> 24) > REGION_IWRAM || (d >> 24) != REGION_IO) {
+			break;
+		}
+		cpu->cycles += 1 + waits[s >> 24];
+		if (cpu->cycles >= cpu->nextEvent) {
+			processEvents(gba);
+		}
+		uint32_t latch = plainLoad(gba, s, wide);
+		if (!wide) {
+			latch *= 0x10001;
+		}
+		dma->latch = latch;
+		gba->dmaLatch = latch;
+		gba->lastAccessDma = true;
+		cpu->cycles += 1 + waits[REGION_IO];
+		if (cpu->cycles >= cpu->nextEvent) {
+			processEvents(gba);
+		}
+		if (wide) {
+			ioWrite32(gba, d & 0xFFFFFC, latch);
+		} else {
+			ioWrite(gba, d & 0xFFFFFE, (uint16_t) (latch >> (8 * (d & 2))));
+		}
+		gba->lastAccessDma = true;
+		s += sourceStep;
+		d += destStep;
+	}
+	dma->nextSource = s;
+	dma->nextDest = d;
+	return n;
+}
