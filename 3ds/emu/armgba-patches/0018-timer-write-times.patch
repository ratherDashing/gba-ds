From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: armGBA speedups <none@example.invalid>
Date: Wed, 25 Nov 2026 01:00:00 -0500
Subject: armGBA: a timer's reload or control write applied at once leaves its
 event's time where the event would have run, so a state is the same bytes as
 armGBA 2.0's (the write event's time is kept in states even while it waits in
 no list)


diff --git a/src/io/timer.c b/src/io/timer.c
index a3984ef..6db6cae 100644
--- a/src/io/timer.c
+++ b/src/io/timer.c
@@ -329,6 +329,8 @@ void timerWriteReload(struct GBA* gba, int id, uint16_t reload) {
 	struct Timer* timer = &gba->timers[id];
 	timer->pendingReload = reload;
 	if (writeAtOnce(gba, timer, false)) {
+		// The time the event would have run at, which a state keeps: the same bytes as a state made with the event.
+		timer->reloadWrite.when = gba->timing.masterCycles + gba->cpu.cycles + 1;
 		reloadWritten(gba, (void*) (intptr_t) id, (uint32_t) -1);
 	} else if (!timingIsScheduled(gba, &timer->reloadWrite)) {
 		timingSchedule(gba, &timer->reloadWrite, 1);
@@ -339,6 +341,7 @@ void timerWriteControl(struct GBA* gba, int id, uint16_t control) {
 	struct Timer* timer = &gba->timers[id];
 	timer->pendingControl = control & 0x00C7;
 	if (writeAtOnce(gba, timer, true)) {
+		timer->controlWrite.when = gba->timing.masterCycles + gba->cpu.cycles + 1;
 		controlWritten(gba, (void*) (intptr_t) id, (uint32_t) -1);
 	} else if (!timingIsScheduled(gba, &timer->controlWrite)) {
 		timingSchedule(gba, &timer->controlWrite, 1);
