+// Tells the renderer about a store into the palette or OAM at offset r0 that changes something:
+// compares the size bytes there with r2 and, if they differ, stores them and sets what in
+// memoryChanged. Uses r1, r3 and r12.
+static void emitSmallVideoStore(struct Emitter* e, int size, uint32_t data, int what) {
+	fieldAddr(e, R3, data);
+	if (size == 4) {
+		aMemR(e, true, false, R12, R3, R0, 0);
+		aDpR(e, C_AL, D_CMP, true, 0, R12, R2, S_LSL, 0);
+	} else {
+		aMemHR(e, true, H_HALF, R12, R3, R0);
+		aDpR(e, C_AL, D_EOR, false, R1, R12, R2, S_LSL, 0);
+		aDpR(e, C_AL, D_MOV, true, R1, 0, R1, S_LSL, 16);
+	}
+	uint8_t* same = aB(e, C_EQ, NULL);
+	if (size == 4) {
+		aMemR(e, false, false, R2, R3, R0, 0);
+	} else {
+		aMemHR(e, false, H_HALF, R2, R3, R0);
+	}
+	ldrbF(e, R1, OFF(renderer.memoryChanged));
+	aDpI(e, C_AL, D_ORR, false, R1, R1, (uint32_t) what);
+	strbF(e, R1, OFF(renderer.memoryChanged));
+	patchHere(e, same);
+}
+
+// Palette RAM (palette true) or OAM, 1 KiB each, mirrored; r1 = address. Neither stalls for the
+// display, and only a 32-bit palette access has a wait state. Byte stores go to C.
+static void emitSmallVideoAccess(struct Emitter* e, int kind, bool romCode, bool palette, uint8_t** toSlow, int* slowCount) {
+	bool store = kind >= MEM_STORE32;
+	int size = accessSize(kind);
+	int cycles = (palette && size == 4 ? 2 : 1) + (store ? 0 : 1);
+	if (store) {
+		// Compiled code covering video memory, or a line whose H-blank has come, is C's to handle.
+		ldrbF(e, R0, OFF(videoCode));
+		aDpI(e, C_AL, D_CMP, true, 0, R0, 0);
+		toSlow[(*slowCount)++] = aB(e, C_NE, NULL);
+		timeUntil(e, R0, R3, cycles, OFF(video.drawDue));
+		toSlow[(*slowCount)++] = aB(e, C_PL, NULL);
+	}
+	cmnCycles(e, cycles);
+	toSlow[(*slowCount)++] = aB(e, C_GE, NULL);
+	emitOffset(e, 10, size);
+	if (store) {
+		emitSmallVideoStore(e, size, palette ? OFF(palette) : OFF(oam), palette ? RENDER_PALETTE : RENDER_OAM);
+		if (romCode) {
+			emitMissSignal(e, kind, false);
+		}
+	} else {
+		fieldAddr(e, R3, palette ? OFF(palette) : OFF(oam));
+		emitLoadData(e, kind, R3);
+	}
+	aAddI(e, R_CYC, R_CYC, cycles, R12);
+	aBx(e, LR);
+}
