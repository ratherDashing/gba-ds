+	void (*widen)(uint32_t* dst, const uint16_t* src);
+	uint32_t* wide[2];
+	int wideIndex;
+	bool wideReady;
+	bool cloneFrame;
 	// Sharing a frame's lines three ways (see "Shared lines" below). Each line's word says who has
