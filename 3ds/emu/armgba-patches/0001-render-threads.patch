 void renderThreadStop(struct GBA*);
+// With late: the workers also turn each row they hand over into the frontend's pixels (widen: one
+// row, whole words), into first and second in turn; set before the first frame. After a frame is
+// handed over, renderThreadWide has the buffer holding it (NULL after a state load); it is written
+// again once the next frame has ended.
+void renderThreadSetWiden(struct GBA*, void (*widen)(uint32_t* dst, const uint16_t* src), uint32_t* first, uint32_t* second);
+const uint32_t* renderThreadWide(struct GBA*);
 void renderThreadClone(struct GBA*);
 // Returns the copy's renderer, with everything logged so far drawn.
 const struct Renderer* renderThreadRenderer(struct GBA*);
