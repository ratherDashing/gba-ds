Subject: armGBA: render threads hand frames over widened for the frontend, and
 find a line's changed video pages eight flags at a time


diff --git a/src/video/render-thread.c b/src/video/render-thread.c
index b94b215..4360239 100644
--- a/src/video/render-thread.c
+++ b/src/video/render-thread.c
@@ -71,6 +71,8 @@ struct Worker {
