 	bool share;
@@ -364,7 +373,7 @@ static uint32_t play(struct GBA* copy, const uint8_t* entry, uint32_t* size) {
 }
 
 // The frame's lines a worker draws, from its copy to where the frame is taken from.
-static void takeLines(const struct Worker* w, uint16_t (*out)[SCREEN_WIDTH]) {
+static void takeLines(const struct Worker* w, uint16_t (*out)[SCREEN_WIDTH], uint32_t* wide) {
 	const struct Renderer* renderer = &w->copy->renderer;
 	struct RenderThread* t = w->owner;
 	if (t->share) {
@@ -374,16 +383,25 @@ static void takeLines(const struct Worker* w, uint16_t (*out)[SCREEN_WIDTH]) {
 			if (owner == HELPER ? w->index == 0 : owner - 1 == w->index) {
 				const struct GBA* from = owner == HELPER ? t->helper : w->copy;
 				memcpy(out[y], from->renderer.frame[y], sizeof(renderer->frame[y]));
+				if (wide) {
+					t->widen(wide + y * SCREEN_WIDTH, out[y]);
+				}
 			}
 		}
 		return;
 	}
 	if (renderer->copy <= 1) {
 		memcpy(out, renderer->frame, sizeof(renderer->frame));
+		for (int y = 0; wide && y < SCREEN_HEIGHT; ++y) {
+			t->widen(wide + y * SCREEN_WIDTH, out[y]);
+		}
 		return;
 	}
 	for (int y = renderer->copy & 1; y < SCREEN_HEIGHT; y += 2) {
 		memcpy(out[y], renderer->frame[y], sizeof(renderer->frame[y]));
+		if (wide) {
+			t->widen(wide + y * SCREEN_WIDTH, out[y]);
+		}
 	}
 }
 
@@ -427,7 +445,11 @@ static void* work(void* context) {
 		}
 #endif
 		if (finish && t->late) {
-			takeLines(w, t->finished);
+			bool const wide = t->widen != NULL;
+			takeLines(w, t->finished, wide ? t->wide[atomic_load(&w->widened) & 1] : NULL);
+			if (wide) {
+				atomic_fetch_add(&w->widened, 1);
+			}
 		}
 		atomic_store(&w->done, done + size);
 		if (finish && atomic_load(&t->awaited)) {
@@ -556,12 +578,17 @@ static void logLine(struct GBA* gba, uint32_t kind, int y) {
 		data += SIZE_PALETTE;
 	}
 	uint64_t pages = 0;
-	for (int page = 0; page < VRAM_PAGES; ++page) {
-		if (renderer->vramChanged[page]) {
-			renderer->vramChanged[page] = 0;
-			pages |= 1ull << page;
-			memcpy(data, &gba->vram[page * VRAM_PAGE], VRAM_PAGE);
-			data += VRAM_PAGE;
+	for (int first = 0; first < VRAM_PAGES; first += 8) {
+		// Eight flags at a time: most lines change none.
+		uint64_t any;
+		memcpy(&any, &renderer->vramChanged[first], sizeof(any));
+		for (int page = first; any && page < first + 8; ++page) {
+			if (renderer->vramChanged[page]) {
+				renderer->vramChanged[page] = 0;
+				pages |= 1ull << page;
+				memcpy(data, &gba->vram[page * VRAM_PAGE], VRAM_PAGE);
+				data += VRAM_PAGE;
+			}
 		}
 	}
 	uint32_t head[4] = { kind, y | changed << 8, (uint32_t) pages, (uint32_t) (pages >> 32) };
@@ -726,7 +753,7 @@ static void finishShared(struct GBA* gba) {
 #endif
 	settleOwners(t);
 	for (int i = 0; i < t->count; ++i) {
-		takeLines(&t->workers[i], gba->renderer.frame);
+		takeLines(&t->workers[i], gba->renderer.frame, NULL);
 	}
 	memset(t->logged, 0, sizeof(t->logged));
 	++t->frameSeq;
@@ -748,7 +775,7 @@ void renderThreadFinishFrame(struct GBA* gba) {
 		entry(gba, LOG_FINISH, 0, 0, 0);
 		drain(t);
 		for (int i = 0; i < t->count; ++i) {
-			takeLines(&t->workers[i], gba->renderer.frame);
+			takeLines(&t->workers[i], gba->renderer.frame, NULL);
 		}
 		renderHooksPublish(gba);
 		shareBegin(gba);
@@ -757,13 +784,34 @@ void renderThreadFinishFrame(struct GBA* gba) {
 	// Takes the frame before this one, before the worker can finish another over it.
 	if (t->finishLogged) {
 		await(t, t->finishLogged);
-		memcpy(gba->renderer.frame, t->finished, sizeof(gba->renderer.frame));
+		// The newest frame the workers finished is the one taken: the next is logged below. The
+		// frontend takes a widened one from wide[], so the renderer's own isn't brought up to date.
+		t->wideReady = t->widen && !t->cloneFrame;
+		t->wideIndex = (int) ((atomic_load(&t->workers[0].widened) - 1) & 1);
+		t->cloneFrame = false;
+		if (!t->wideReady) {
+			memcpy(gba->renderer.frame, t->finished, sizeof(gba->renderer.frame));
+		}
 		renderHooksPublish(gba);
 	}
 	entry(gba, LOG_FINISH, 0, 0, 0);
 	t->finishLogged = t->head;
 }
 
+void renderThreadSetWiden(struct GBA* gba, void (*widen)(uint32_t* dst, const uint16_t* src), uint32_t* first, uint32_t* second) {
+	struct RenderThread* t = gba->renderThread;
+	if (t && t->late) {
+		t->wide[0] = first;
+		t->wide[1] = second;
+		t->widen = widen;
+	}
+}
+
+const uint32_t* renderThreadWide(struct GBA* gba) {
+	struct RenderThread* t = gba->renderThread;
+	return t && t->wideReady ? t->wide[t->wideIndex] : NULL;
+}
+
 int renderThreadCopies(struct GBA* gba, struct GBA* copies[2]) {
 	struct RenderThread* t = gba->renderThread;
 	if (!t) {
@@ -796,6 +844,7 @@ void renderThreadClone(struct GBA* gba) {
 	}
 	// When late, the frame handed over next is the one this renderer last finished.
 	memcpy(t->finished, gba->renderer.frame, sizeof(t->finished));
+	t->cloneFrame = true;
 	shareBegin(gba);
 }
 
@@ -811,9 +860,9 @@ const struct Renderer* renderThreadRenderer(struct GBA* gba) {
 	memcpy(t->merged, &t->workers[0].copy->renderer, sizeof(*t->merged));
 	if (t->share) {
 		settleOwners(t);
-		takeLines(&t->workers[0], t->merged->frame);
+		takeLines(&t->workers[0], t->merged->frame, NULL);
 	}
-	takeLines(&t->workers[1], t->merged->frame);
+	takeLines(&t->workers[1], t->merged->frame, NULL);
 	// What a copy keeps from the lines it drew depends on which lines it happened to draw.
 	renderForget(t->merged);
 	return t->merged;
diff --git a/src/video/render.h b/src/video/render.h
index 73339bd..5debb4c 100644
--- a/src/video/render.h
+++ b/src/video/render.h
@@ -300,6 +300,12 @@ void renderFinishFrame(struct GBA*);
 // drawing overlaps emulation. With second, two threads draw, each every other line.
