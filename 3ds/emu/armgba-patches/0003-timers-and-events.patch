--- a/src/io/timer.c
+++ b/src/io/timer.c
@@ -142,9 +142,17 @@ static void catchUp(struct GBA* gba, int id, uint32_t time, bool inclusive) {
 	}
 }
 
+static void overflowEvent(struct GBA* gba, void* context, uint32_t late);
+static void reloadWritten(struct GBA* gba, void* context, uint32_t late);
+static void controlWritten(struct GBA* gba, void* context, uint32_t late);
+
 // Whether a timer event can run after the instruction it falls in instead of inside it: not if it
 // can start DMA, which an overflow asking for more FIFO data does.
 bool timerDeferrable(struct GBA* gba, const struct Event* event) {
+	// Only a timer's own events can ask for FIFO data; the list hands this every event in a window.
+	if (event->callback != overflowEvent && event->callback != reloadWritten && event->callback != controlWritten) {
+		return true;
+	}
 	for (int id = 0; id < 4; ++id) {
 		struct Timer* timer = &gba->timers[id];
 		if (event != &timer->event && event != &timer->controlWrite && event != &timer->reloadWrite) {
diff --git a/src/timing.c b/src/timing.c
index 758cabc..54061e2 100644
--- a/src/timing.c
+++ b/src/timing.c
@@ -237,6 +237,9 @@ bool timingDeferrable(struct GBA* gba, int32_t time) {
 		if (untilEvent(gba, event) > time) {
 			break;
 		}
+		if (gbaIrqEvent(event)) {
+			continue;
+		}
 		if (event->endsRun || dmaStartEvent(event) || !videoDeferrable(gba, event) || !timerDeferrable(gba, event)) {
 			return false;
 		}
