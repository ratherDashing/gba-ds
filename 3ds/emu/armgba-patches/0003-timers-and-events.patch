Subject: armGBA: timers and the interrupt pipeline's events are deferrable
 without asking DMA, video and timers


diff --git a/src/gba.c b/src/gba.c
index c097152..8929a84 100644
--- a/src/gba.c
+++ b/src/gba.c
@@ -84,6 +84,12 @@ static void applyIrq(struct GBA* gba, void* context, uint32_t late) {
 	}
 }
 
+// Whether an event is one of the pipeline's stages: none starts DMA, so each can run after the
+// instruction it falls in.
+bool gbaIrqEvent(const struct Event* event) {
+	return event->callback == applyIrq || event->callback == availableChanged || event->callback == lineChanged;
+}
