+enum {
+	EVICT_FILTER = 1 << 15,
+};
+
+// A bit for each block going away in a filter on the stack: a block whose bit is clear isn't one, so a list
+// can be passed over without reading its blocks, a cache miss each.
+static uint32_t evictFilterBit(const struct Block* block) {
+	return (uint32_t) ((uintptr_t) block >> 3) * 0x9E3779B1u >> 17;
+}
+
+static bool evictFilterHas(const uint32_t* filter, const struct Block* block) {
+	uint32_t const bit = evictFilterBit(block);
+	return (filter[bit / 32] >> (bit % 32)) & 1;
+}
+
+static void evictFilterAdd(uint32_t* filter, const struct Block* block) {
+	uint32_t const bit = evictFilterBit(block);
+	filter[bit / 32] |= 1u << (bit % 32);
+}
+
