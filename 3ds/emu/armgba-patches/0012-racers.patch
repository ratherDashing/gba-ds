diff --git a/src/io/timer.c b/src/io/timer.c
index 5277bcb..9240df5 100644
--- a/src/io/timer.c
+++ b/src/io/timer.c
@@ -138,33 +138,42 @@ static void catchUp(struct GBA* gba, int id, uint32_t time, bool inclusive) {
 	}
 }
 
+static void overflowEvent(struct GBA* gba, void* context, uint32_t late);
+
+// Whether a FIFO's channel is short enough of data that an overflow asks its DMA for more.
+static bool fifoRoom(const struct Fifo* channel) {
+	int size = channel->fifoWrite - channel->fifoRead;
+	size = size < 0 ? size + AUDIO_FIFO_SIZE : size;
+	return AUDIO_FIFO_SIZE - size > 4;
+}
+
 // Whether a timer event can run after the instruction it falls in instead of inside it: not if it
-// can start DMA, which an overflow asking for more FIFO data does.
-bool timerDeferrable(struct GBA* gba, const struct Event* event) {
+// can start DMA, which an overflow asking for more FIFO data does. window is how long after the
+// event the instruction's check reaches, and oneStore says the instruction makes at most one store,
+// the last of its accesses.
+bool timerDeferrable(struct GBA* gba, const struct Event* event, int32_t window, bool oneStore) {
 	// Only a timer's own events, which lie in the timers, can ask for FIFO data; the list hands this
 	// every event in a window.
 	if ((uintptr_t) event - (uintptr_t) gba->timers >= sizeof(gba->timers)) {
 		return true;
 	}
-	for (int id = 0; id < 4; ++id) {
-		struct Timer* timer = &gba->timers[id];
-		if (event != &timer->event && event != &timer->controlWrite && event != &timer->reloadWrite) {
-			continue;
-		}
-		// An overflow can ask a FIFO's channel for more data.
-		for (int fifo = 0; fifo < 2; ++fifo) {
-			struct Fifo* channel = fifo ? &gba->audio.chB : &gba->audio.chA;
-			for (int t = id; t < 4; ++t) {
-				if (feeds(gba, fifo, t) && channel->dmaSource > 0 && dmaFifoArmed(gba, channel->dmaSource)) {
-					return false;
-				}
-				// When cascaded, it ticks the timers after it.
-				if (t + 1 < 4 && !(gba->timers[t + 1].enable && gba->timers[t + 1].countUp)) {
-					break;
-				}
+	int const id = (int) (intptr_t) event->context;
+	struct Timer* timer = &gba->timers[id];
+	// A lone overflow of a timer with none caught up late asks only if the FIFO has room, which
+	// nothing in the instruction before it can change (a store to the sound control could).
+	bool lone = oneStore && event->callback == overflowEvent && !timer->quiet && !cascades(gba, id) && !gba->cpu.overclock && period(timer) > window;
+	// An overflow can ask a FIFO's channel for more data.
+	for (int fifo = 0; fifo < 2; ++fifo) {
+		struct Fifo* channel = fifo ? &gba->audio.chB : &gba->audio.chA;
+		for (int t = id; t < 4; ++t) {
+			if (feeds(gba, fifo, t) && channel->dmaSource > 0 && dmaFifoArmed(gba, channel->dmaSource) && (!lone || fifoRoom(channel))) {
+				return false;
+			}
+			// When cascaded, it ticks the timers after it.
+			if (t + 1 < 4 && !(gba->timers[t + 1].enable && gba->timers[t + 1].countUp)) {
+				break;
 			}
 		}
-		return true;
 	}
 	return true;
 }
