-// Whether the events due by time can run late, at the next instruction boundary: none of them
-// starts DMA or ends a run.
-bool timingDeferrable(struct GBA*, int32_t time);
+// What jitHelperCareful is told of an instruction's events: none may run after it, those that start
+// no DMA may, the same and it makes at most one store (its last access), or all may (but one that
+// ends the run) because its fetch is its only access.
+enum {
+	DEFER_NO,
+	DEFER_YES,
+	DEFER_ONE_STORE,
+	DEFER_FETCH_ONLY,
+};
+// Whether the events due by time can run late, at the next instruction boundary: for the kinds above.
+bool timingDeferrable(struct GBA*, int32_t time, int kind);
 void processEvents(struct GBA*);
 
