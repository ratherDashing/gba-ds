 }
 
+void jitSetDeferMore(struct GBA* gba, bool on) {
+	if (gba->jit) {
+		gba->jit->deferOld = !on;
+	}
+}
+
 size_t jitCodeUsed(struct GBA* gba, size_t* size) {
 	struct Jit* jit = gba->jit;
 	if (size) {
@@ -2946,7 +2952,10 @@ int jitHelperCareful(struct GBA* gba, int32_t cost, int deferrable, const struct
 	if (cpu->cycles + cost < cpu->nextEvent) {
 		return CAREFUL_RUN;
 	}
-	if (deferrable && timingDeferrable(gba, cpu->cycles + cost)) {
+	if (gba->jit->deferOld && deferrable > DEFER_YES) {
+		deferrable = DEFER_YES;
+	}
+	if (deferrable && timingDeferrable(gba, cpu->cycles + cost, deferrable)) {
 		gba->jitDeferred = true;
 		return CAREFUL_RUN;
 	}
