diff --git a/src/cpu/jit-compile.h b/src/cpu/jit-compile.h
index 0630cb0..ff45a9d 100644
--- a/src/cpu/jit-compile.h
+++ b/src/cpu/jit-compile.h
@@ -470,13 +470,19 @@ static int ownCost(struct Compiler* c, int index) {
 	return cycles + highest;
 }
 
-// Whether events inside an instruction can run once it is done: after it in the copy, or where it
-// goes, at the check there (or in the run loop) before anything else runs.
-static bool deferrable(const struct Compiler* c, int index) {
+// Which events inside an instruction can run once it is done (the DEFER_ kinds in gba.h): after it in
+// the copy, or where it goes, at the check there (or in the run loop) before anything else runs.
+static int deferrable(const struct Compiler* c, int index) {
 	const struct Inst* in = &c->insts[index];
 	// Not past a CPSR write: an IRQ an event asks for would then see the mask from after it, not
 	// before.
-	return !in->poly && !jitStepOnly(in) && (!jitSystem(in) || (in->kind == I_MSR && in->spsr)) && in->cond != 0xF;
+	if (in->poly || jitStepOnly(in) || (jitSystem(in) && !(in->kind == I_MSR && in->spsr)) || in->cond == 0xF) {
+		return DEFER_NO;
+	}
+	if (in->kind == I_ALU && in->rd != 15 && (in->op2.isImm || !in->op2.byReg)) {
+		return DEFER_FETCH_ONLY;
+	}
+	return in->kind == I_BLOCK ? DEFER_YES : DEFER_ONE_STORE;
 }
 
 // Whether a deferral is taken up straight after the instruction, in the copy.
