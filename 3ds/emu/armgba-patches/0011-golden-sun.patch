+static int compileAfterSetting = COMPILE_AFTER;
+
+// The frontend's own count of first visits stepped before a block compiles (1 to 250; 0 or less: as built).
+void jitSetCompileAfter(int times) {
+	compileAfterSetting = times <= 0 ? COMPILE_AFTER : times > 250 ? 250 : times;
+}
