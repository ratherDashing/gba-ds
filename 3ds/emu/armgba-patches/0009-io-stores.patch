diff --git a/src/cpu/jit.c b/src/cpu/jit.c
index 6acfe51..00e5448 100644
--- a/src/cpu/jit.c
+++ b/src/cpu/jit.c
@@ -550,6 +550,24 @@ static bool loadsPc(struct GBA* gba) {
 	return in.kind == I_MEM && in.load && in.rd == 15;
 }
 
+// What follows a slow access: events it ran hand control back to the run loop.
+static uint32_t slowDone(struct GBA* gba, uint32_t runs, uint32_t result) {
+	if (runs != gba->eventRuns) {
+		yield(gba);
+		// Without the prefetch buffer, cartridge code adds the next fetch's nonsequential part once
+		// this returns, and then leaves. An interrupt the events raised is taken before that fetch,
+		// so the fetch is left for whatever runs next to count: the exact CPU, or compiled code
+		// entered again.
+		syncSite(gba);
+		if (inRom(gba->cpu.r[15]) && !gba->prefetchEnabled && !gba->prefetchDisabled && !loadsPc(gba)) {
+			gba->cpu.cycles -= fetchGap(gba);
+			gba->cpu.fetchSeq = false;
+		}
+	}
+	gba->siteValid = false;
+	return result;
+}
+
 uint32_t jitSlowAccess(struct GBA* gba, int kind, uint32_t address, uint32_t value) {
 	// The PC is looked up only if something asks for it.
 	gba->siteValid = true;
@@ -580,20 +598,46 @@ uint32_t jitSlowAccess(struct GBA* gba, int kind, uint32_t address, uint32_t val
 	if (kind < MEM_STORE32) {
 		busIdle(gba);
 	}
-	if (runs != gba->eventRuns) {
-		yield(gba);
-		// Without the prefetch buffer, cartridge code adds the next fetch's nonsequential part once
-		// this returns, and then leaves. An interrupt the events raised is taken before that fetch,
-		// so the fetch is left for whatever runs next to count: the exact CPU, or compiled code
-		// entered again.
-		syncSite(gba);
-		if (inRom(gba->cpu.r[15]) && !gba->prefetchEnabled && !gba->prefetchDisabled && !loadsPc(gba)) {
-			gba->cpu.cycles -= fetchGap(gba);
-			gba->cpu.fetchSeq = false;
+	return slowDone(gba, runs, result);
+}
+
+// A compiled store to an I/O register: when no event, DMA or idle-loop log comes before the write, the part of
+// jitSlowAccess that remains, with the registers interrupt handlers write the most (IE, IF, IME) called directly.
+uint32_t jitIoStore(struct GBA* gba, int kind, uint32_t address, uint32_t value) {
+	int32_t cycles = 1 + (kind == MEM_STORE32 ? gba->waitN32[REGION_IO] : gba->waitN16[REGION_IO]);
+	if (gba->idleProbing || gba->dmaRunnable || gba->cpu.cycles + cycles >= gba->cpu.nextEvent) {
+		return jitSlowAccess(gba, kind, address, value);
+	}
+	gba->siteValid = true;
+	uint32_t runs = gba->eventRuns;
+	gba->dmaIdleCredit = 0;
+	gba->cpu.cycles += cycles;
+	switch (kind) {
+	case MEM_STORE32:
+		ioWrite32(gba, address & 0xFFFFFC, value);
+		break;
+	case MEM_STORE16:
+		switch (address & 0xFFFFFE) {
+		case REG_IE:
+			gbaWriteIe(gba, (uint16_t) value);
+			break;
+		case REG_IF:
+			gbaWriteIf(gba, (uint16_t) value);
+			break;
+		case REG_IME:
+			gbaWriteIme(gba, (uint16_t) value);
+			break;
+		default:
+			ioWrite(gba, address & 0xFFFFFE, (uint16_t) value);
+			break;
 		}
+		break;
+	default:
+		ioWrite8(gba, address & 0xFFFFFF, (uint8_t) value);
+		break;
 	}
-	gba->siteValid = false;
-	return result;
+	gba->lastAccessDma = false;
+	return slowDone(gba, runs, 0);
 }
 
