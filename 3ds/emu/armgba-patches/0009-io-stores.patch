-static void emitSlowPath(struct Emitter* e, int kind, bool romCode) {
+static void emitSlowPath(struct Emitter* e, int kind, bool romCode, const void* handler) {
 	// The return address identifies the guest instruction for open-bus reads.
 	strF(e, LR, OFF(siteReturn));
 	ldrF(e, R0, OFF(cpu.nextEvent));
@@ -480,7 +480,7 @@ static void emitSlowPath(struct Emitter* e, int kind, bool romCode) {
 	aMov(e, R2, R1);
 	aMovI(e, R1, kind);
 	aMov(e, R0, R_GBA);
-	callAbs(e, jitSlowAccess);
+	callAbs(e, handler);
 	if (kind == MEM_LOADS8) {
 		aExtend(e, X_SXTB, R0, R0);
 	} else if (kind == MEM_LOADS16) {
@@ -772,6 +772,11 @@ static uint8_t* emitMemRoutine(struct Jit* jit, struct Emitter* e, int kind, boo
 		aCmpI(e, R0, REGION_OAM - base, R3);
 		toOam = aB(e, C_EQ, NULL);
 	}
+	uint8_t* toIoStore = NULL;
+	if (store) {
+		aCmpI(e, R0, REGION_IO, R3);
+		toIoStore = aB(e, C_EQ, NULL);
+	}
 	toSlow[slowCount++] = aB(e, C_AL, NULL);
 
 	for (int r = 0; r < 2; ++r) {
@@ -966,10 +971,15 @@ static uint8_t* emitMemRoutine(struct Jit* jit, struct Emitter* e, int kind, boo
 		aBx(e, LR);
 	}
 
+	if (toIoStore) {
+		// Stores to I/O registers: interrupt handlers make hundreds of them a frame.
+		patchHere(e, toIoStore);
