-// Writes to a timer take effect one cycle later, so they are events.
+// Writes to a timer take effect one cycle later, so they are events. With no event due by then and no overflow
+// of the timer's own to settle, the write is applied at once as of that cycle (late -1), as gba.c's applyWrite does.
+static bool writeAtOnce(struct GBA* gba, const struct Timer* written, bool control) {
+	struct Timing* timing = &gba->timing;
+	if (gba->performingDma || gba->cpu.overclock || gba->inEvent || timing->reroot) {
+		return false;
+	}
+	if (timing->root && timingUntil(gba, timing->root) <= 1) {
+		return false;
+	}
+	// A quiet overflow due by then would feed a FIFO with a time ahead of the clock, which DMA's request can't take.
+	uint32_t const due = timingCurrentTime(gba) + 1;
+	for (int id = 0; id < 4; ++id) {
+		const struct Timer* timer = &gba->timers[id];
+		if (timer->quiet && (int32_t) (timer->started + period(timer) - due) <= 0) {
+			return false;
+		}
+	}
+	// Stopping a running timer past its overflow would hand overflow() a late of -1.
+	return !control || !written->running || written->counter + ((due - written->started) >> written->prescaleBits) < 0x10000;
+}
+
 void timerWriteReload(struct GBA* gba, int id, uint16_t reload) {
 	struct Timer* timer = &gba->timers[id];
 	timer->pendingReload = reload;
