+// A careful copy's stubs share two routines, each reached by a BL at the stub's entry: the BL's return
+// address is the stub's "b resume", with the stub's constants in the words after it. Control
+// comes back to that branch when the events inside the instruction ran after it; the rest leaves
+// as the stub's own code once did.
+enum {
+	// In a stub's flags word, over the instruction's kind (the helper's third argument).
+	STUB_PRECHARGED = 0x100,
+	STUB_HEAD = 0x200,
+	// Where each word of a stub's constants is, from the return address.
+	STUB_PC = 4,
+	STUB_COST = 8,
+	STUB_BLOCK = 12,
+	STUB_FLAGS = 16,
+	STUB_ENTRY = 20,
+	STUB_KEY = 24,
+	STUB_HEAD_AT = 28,
+	// The deferred stub's: the instruction after, the block, the flags and the prefetch head.
+	DEFER_PC = 4,
+	DEFER_BLOCK = 8,
+	DEFER_FLAGS = 12,
+	DEFER_HEAD_AT = 16,
+};
+
+static void emitCarefulStub(struct Jit* jit, struct Emitter* e) {
+	// The stub's address (lr) stays on the stack across the C calls.
+	aPush(e, (1 << R0) | (1 << LR));
+	aLdr(e, R3, LR, STUB_FLAGS);
+	aDpI(e, C_AL, D_TST, true, 0, R3, STUB_HEAD);
+	uint8_t* noHead = aB(e, C_EQ, NULL);
+	aLdr(e, R1, LR, STUB_HEAD_AT);
+	strF(e, R1, OFF(prefetcher.head));
+	patchHere(e, noHead);
+	aDpI(e, C_AL, D_TST, true, 0, R3, STUB_PRECHARGED);
+	uint8_t* toStep = aB(e, C_NE, NULL);
+	aBl(e, jit->spillCyclesRoutine);
+	aLdr(e, R3, SP, 4);
+	aMov(e, R0, R_GBA);
+	aLdr(e, R1, R3, STUB_COST);
+	aLdr(e, R2, R3, STUB_FLAGS);
+	aDpI(e, C_AL, D_AND, false, R2, R2, 0xFF);
+	aLdr(e, R3, R3, STUB_BLOCK);
+	callAbs(e, jitHelperCareful);
+	aBl(e, jit->reloadCyclesRoutine);
+	aLdr(e, R3, SP, 4);
+	aDpI(e, C_AL, D_CMP, true, 0, R0, CAREFUL_RUN);
+	uint8_t* run = aB(e, C_EQ, NULL);
+	aDpI(e, C_AL, D_CMP, true, 0, R0, CAREFUL_LEAVE);
+	uint8_t* leaveHere = aB(e, C_EQ, NULL);
+	patchHere(e, toStep);
+	// The exact CPU runs the instruction; compiled code continues after it, here if the copy is still there.
+	aBl(e, jit->spillRoutine);
+	aLdr(e, R3, SP, 4);
+	aMov(e, R0, R_GBA);
+	aLdr(e, R1, R3, STUB_PC);
+	callAbs(e, jitHelperStepOne);
+	aBl(e, jit->reloadRoutine);
+	aLdr(e, R3, SP, 4);
+	aDpI(e, C_AL, D_CMN, true, 0, R0, 1);
+	uint8_t* leave = aB(e, C_EQ, NULL);
+	aLdr(e, R1, R3, STUB_ENTRY);
+	aDpI(e, C_AL, D_CMP, true, 0, R1, 0);
+	uint8_t* last = aB(e, C_EQ, NULL);
+	aLdr(e, R2, R3, STUB_KEY);
+	aDpR(e, C_AL, D_CMP, true, 0, R0, R2, S_LSL, 0);
+	uint8_t* elsewhere = aB(e, C_NE, NULL);
+	aLdr(e, R2, R3, STUB_BLOCK);
+	aLdrb(e, R2, R2, (int32_t) offsetof(struct Block, valid));
+	aDpI(e, C_AL, D_CMP, true, 0, R2, 0);
+	uint8_t* gone = aB(e, C_EQ, NULL);
+	aDpI(e, C_AL, D_ADD, false, SP, SP, 8);
+	aBx(e, R1);
+	patchHere(e, last);
+	patchHere(e, elsewhere);
+	patchHere(e, gone);
+	aDpI(e, C_AL, D_ADD, false, SP, SP, 8);
+	aB(e, C_AL, jit->dispatchKey);
+	patchHere(e, leave);
+	strFImm(e, OFF(exitReason), EXIT_EXACT, 4, LR);
+	aB(e, C_AL, jit->exitRoutine);
+	// Leaves between instructions, for the run loop.
+	patchHere(e, leaveHere);
+	aLdr(e, R1, R3, STUB_PC);
+	strF(e, R1, OFF(exitPc));
+	strFImm(e, OFF(exitReason), EXIT_LOOKUP, 4, R1);
+	aB(e, C_AL, jit->exitRoutine);
+	patchHere(e, run);
+	aPop(e, (1 << R0) | (1 << LR));
+	aBx(e, LR);
+}
+
+// The events inside the instruction just done.
+static void emitDeferredStub(struct Jit* jit, struct Emitter* e) {
+	aPush(e, (1 << R0) | (1 << LR));
+	aLdr(e, R3, LR, DEFER_FLAGS);
+	aDpI(e, C_AL, D_TST, true, 0, R3, STUB_HEAD);
+	uint8_t* noHead = aB(e, C_EQ, NULL);
+	aLdr(e, R1, LR, DEFER_HEAD_AT);
+	strF(e, R1, OFF(prefetcher.head));
+	patchHere(e, noHead);
+	aBl(e, jit->spillCyclesRoutine);
+	aLdr(e, R3, SP, 4);
+	aMov(e, R0, R_GBA);
+	aLdr(e, R1, R3, DEFER_BLOCK);
+	callAbs(e, jitHelperDeferred);
+	aBl(e, jit->reloadCyclesRoutine);
+	aLdr(e, R3, SP, 4);
+	aDpI(e, C_AL, D_CMP, true, 0, R0, 0);
+	uint8_t* run = aB(e, C_EQ, NULL);
+	aLdr(e, R1, R3, DEFER_PC);
+	strF(e, R1, OFF(exitPc));
+	strFImm(e, OFF(exitReason), EXIT_LOOKUP, 4, R1);
+	aB(e, C_AL, jit->exitRoutine);
+	patchHere(e, run);
+	aPop(e, (1 << R0) | (1 << LR));
+	aBx(e, LR);
+}
