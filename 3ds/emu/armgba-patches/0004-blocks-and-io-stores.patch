From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: armGBA speedups <none@example.invalid>
Date: Tue, 17 Nov 2026 09:43:42 -0500
Subject: armGBA: halfword I/O stores from compiled code go straight to
 ioWrite, and a place returned to inside a block gets a block of its own


diff --git a/src/bus.c b/src/bus.c
index 26c0ada..7b9901d 100644
--- a/src/bus.c
+++ b/src/bus.c
@@ -249,6 +249,17 @@ void busWrite(struct GBA* gba, uint32_t address, uint32_t value, int size, bool
 	gba->lastAccessDma = false;
 }
 
+// A halfword write to an I/O register, the same as busWrite makes it with the other regions' cases left out.
+void busWriteIo16(struct GBA* gba, uint32_t address, uint16_t value) {
+	if (gba->idleProbing) {
+		jitIdleWrite(gba, address, value, 2);
+	}
+	cpuAccess(gba, false);
+	busTick(gba, 1 + gba->waitN16[REGION_IO]);
+	ioWrite(gba, address & 0xFFFFFE, value);
+	gba->lastAccessDma = false;
+}
+
 // An instruction fetch. From the cartridge, it goes through the prefetch buffer, which may already
 // have the word and so make the fetch cost one cycle.
 uint32_t busFetch(struct GBA* gba, uint32_t address, bool thumb) {
diff --git a/src/cpu/jit-internal.h b/src/cpu/jit-internal.h
index 16d8d0c..8ab16da 100644
--- a/src/cpu/jit-internal.h
+++ b/src/cpu/jit-internal.h
@@ -445,6 +445,10 @@ struct Jit {
 	// an event (midResume), or from an interrupt (irqReturn, ~0 when none is pending).
 	bool midResume;
 	uint32_t irqReturn;
+	// Returns to the same place inside a block (by lookup slot, in seenCount) before a block is compiled there
+	// instead of stepping the rest of this one (0: never), and how many such blocks since the last flush.
+	uint8_t midAfter;
+	uint32_t midCompiled;
 	bool coldThumb;
 	int coldLeft;
 	uint8_t* hotMark;
diff --git a/src/cpu/jit.c b/src/cpu/jit.c
index 9ce8918..308c894 100644
--- a/src/cpu/jit.c
+++ b/src/cpu/jit.c
@@ -485,7 +485,11 @@ uint32_t jitSlowAccess(struct GBA* gba, int kind, uint32_t address, uint32_t val
 		busWrite(gba, address, value, 4, false);
 		break;
 	case MEM_STORE16:
-		busWrite(gba, address, value, 2, false);
+		if ((address >> 24) == REGION_IO) {
+			busWriteIo16(gba, address, (uint16_t) value);
+		} else {
+			busWrite(gba, address, value, 2, false);
+		}
 		break;
 	default:
 		busWrite(gba, address, value, 1, false);
@@ -514,6 +518,7 @@ uint32_t jitSlowAccess(struct GBA* gba, int kind, uint32_t address, uint32_t val
 void jitFlush(struct GBA* gba) {
 	struct Jit* jit = gba->jit;
 	freeAll(jit);
+	jit->midCompiled = 0;
 	jit->rangeCount = 0;
 	jit->coldRangeCount = 0;
 	for (int i = 0; i < LOOKUP_SIZE; ++i) {
@@ -541,6 +546,12 @@ void jitFlush(struct GBA* gba) {
 	++jit->flushes;
 }
 
+void jitSetMidAfter(struct GBA* gba, int times) {
+	if (gba->jit) {
+		gba->jit->midAfter = (uint8_t) (times < 0 ? 0 : times > 255 ? 255 : times);
+	}
+}
+
 size_t jitCodeUsed(struct GBA* gba, size_t* size) {
 	struct Jit* jit = gba->jit;
 	if (size) {
@@ -1421,6 +1432,10 @@ enum {
 	// exact CPU steps to the event. Yoshi's Island's took half of a 3DS's 9 MiB within 20-30 s,
 	// filling it (each flush a 100-170 ms frame, 2026-11-16).
 	CAREFUL_SHARE = 3,
+	// The most blocks compiled for returns into a block's middle between flushes: one per 16 KiB of code memory.
+	MID_BLOCK_SHIFT = 14,
+	// Returns to one place before it gets a block (jit->midAfter, before the frontend's setting).
+	MID_AFTER = 16,
 };
 
 // Whether careful copies have taken their share of the code memory since it was last emptied.
@@ -2037,13 +2052,22 @@ void jitRunLoop(struct GBA* gba) {
 		if (!entry && mid && !gba->traceFile && !findBlock(jit, key)) {
 			const struct Block* within = blockWithin(jit, pc, thumb);
 			if (within) {
-				jit->coldPc = pc + width;
-				jit->coldThumb = thumb;
-				jit->coldLeft = (int) ((within->end - pc) / (uint32_t) width) - 1;
-				++jit->stepped;
-				++jit->midSteps;
-				stepInstruction(gba);
-				continue;
+				// A place that keeps being returned to, as an interrupt returns to the same instruction line
+				// after line, gets a block of its own; the rest, whose events fall all over, are stepped.
+				uint8_t* seen = &jit->seenCount[lookupHash(key)];
+				if (!jit->midAfter || *seen < jit->midAfter || jit->midCompiled >= jit->codeSize >> MID_BLOCK_SHIFT || compileBusy()) {
+					if (jit->midAfter && *seen < jit->midAfter) {
+						++*seen;
+					}
+					jit->coldPc = pc + width;
+					jit->coldThumb = thumb;
+					jit->coldLeft = (int) ((within->end - pc) / (uint32_t) width) - 1;
+					++jit->stepped;
+					++jit->midSteps;
+					stepInstruction(gba);
+					continue;
+				}
+				++jit->midCompiled;
 			}
 		}
 		if (!entry) {
@@ -2655,6 +2679,7 @@ bool jitInit(struct GBA* gba) {
 	}
 	jit->gba = gba;
 	gba->jit = jit;
+	jit->midAfter = MID_AFTER;
 #if defined(__3DS__)
 	jit->codeSize = CODE_SIZE;
 	jit->code = jitHostAllocCode(&jit->codeSize);
diff --git a/src/cpu/jit.h b/src/cpu/jit.h
index 9f6f698..f324821 100644
--- a/src/cpu/jit.h
+++ b/src/cpu/jit.h
@@ -29,6 +29,9 @@ int32_t jitFetchGap(struct GBA*);
 // gap: jitFetchGap from before the change.
 void jitWaitstatesChanged(struct GBA*, int32_t gap);
 void jitFlush(struct GBA*);
+// How many times the CPU returns to the same place inside a block (from an interrupt, or an event
+// stepped up to) before a block is compiled there, instead of stepping the rest of this block; 0: never.
+void jitSetMidAfter(struct GBA*, int times);
 // The code memory compiled code takes so far, and (size) all there is: for a frontend that empties it
 // (jitFlush) at a moment of its choosing, before it fills at one of the game's.
 size_t jitCodeUsed(struct GBA*, size_t* size);
diff --git a/src/gba.h b/src/gba.h
index c5e8c66..c66ea35 100644
--- a/src/gba.h
+++ b/src/gba.h
@@ -1061,6 +1061,7 @@ int32_t busCycles(struct GBA*, uint32_t address, int size, bool seq);
 void busTick(struct GBA*, int32_t cycles);
 uint32_t busRead(struct GBA*, uint32_t address, int size, bool seq);
 void busWrite(struct GBA*, uint32_t address, uint32_t value, int size, bool seq);
+void busWriteIo16(struct GBA*, uint32_t address, uint16_t value);
 uint32_t busFetch(struct GBA*, uint32_t address, bool thumb);
