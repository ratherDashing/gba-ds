+// Whether only the way out at the next instruction's check (a multiply's time depends on its operands)
+// can read the carry: the code that goes on sets C first, so that check's cold code works it out.
+static bool carryLazy(const struct Compiler* c, const struct Inst* in) {
+	int next = c->cur + 1;
+	// A rewritten word holding a form not seen yet leaves the block before running, C unset.
+	if (!c->jit->lazyCarry || in->poly || in->cond != COND_AL || next >= c->count || !c->checkpoint[next] || c->insts[next].poly) {
+		return false;
+	}
+	const struct Inst* after = &c->insts[next];
+	return !((flagReads(after) | (c->liveAfter[next] & ~flagWrites(after))) & F_C);
+}
