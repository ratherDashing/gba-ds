+// Where a return into the middle of a block (not at one of its starts) carries on in its careful
+// copy, which can be entered before any of its instructions; NULL to step the rest of the block.
+static void* midCareful(struct GBA* gba, struct Block* within, uint32_t pc, bool thumb) {
+	struct Jit* jit = gba->jit;
+	int const index = (int) ((pc - within->pc) / (thumb ? 2u : 4u));
+	if (!within->twin && jit->midCareful >= 2 && !jit->flushRequested && !jit->waitsChanged) {
+		// The return is an event that fell inside the block, so it earns the copy as those do.
+		if (gba->video.frameCounter - within->firesFrom > CAREFUL_FRAMES) {
+			within->checkFires = 0;
+			within->firesFrom = gba->video.frameCounter;
+		}
+		if (within->checkFires < CAREFUL_AFTER) {
+			++within->checkFires;
+		} else if (!carefulFull(jit)) {
+			uint64_t flushes = jit->flushes;
+			twinOf(gba, within);
+			if (flushes != jit->flushes) {
+				return NULL;
+			}
+		}
+	}
+	struct Block* twin = within->twin;
+	if (!twin || !twin->valid || !within->valid || index >= twin->count) {
+		return NULL;
+	}
+	return twin->entries[index];
+}
