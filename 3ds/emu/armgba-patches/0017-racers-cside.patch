+// copies drawing does, syncing the video first; the CPU's clock is the console's.
+static inline void renderBatchWrite(struct GBA* gba, struct RenderBatch* batch, uint32_t address, uint16_t value) {
+	if ((int32_t) (timingCpuTime(gba) - gba->video.stableUntil) >= 0) {
+		// (what the sync does may log: after what is batched)
+		renderBatchFlush(gba, batch);
