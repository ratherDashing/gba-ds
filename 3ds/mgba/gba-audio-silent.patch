 void GBAudioRun(struct GBAudio* audio, int32_t timestamp, int channels);
+
+/* GBAudioRun(audio, timestamp, 0xF) for the GBA's sampling loop, called only when some channel has anything to do. */
+static inline void GBAudioRunSample(struct GBAudio* audio, int32_t timestamp) {
+	if (audio->p || (audio->playingCh1 && audio->ch1.envelope.dead != 2) || timestamp - audio->ch1.lastUpdate > 0x40000000 ||
+	    (audio->playingCh2 && audio->ch2.envelope.dead != 2) || timestamp - audio->ch2.lastUpdate > 0x40000000 ||
+	    audio->playingCh3 || audio->playingCh4) {
+		GBAudioRun(audio, timestamp, 0xF);
+	}
+}
