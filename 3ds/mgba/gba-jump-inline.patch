diff --git a/include/mgba/internal/gba/gba.h b/include/mgba/internal/gba/gba.h
index 65e994dc6..2520d586e 100644
--- a/include/mgba/internal/gba/gba.h
+++ b/include/mgba/internal/gba/gba.h
@@ -191,6 +191,27 @@ void GBATestKeypadIRQ(struct GBA* gba);
 void GBAFrameStarted(struct GBA* gba);
 void GBAFrameEnded(struct GBA* gba);
 
+/* The usual jump (same region, no idle loop to check) needs no more than this; false leaves the rest to
+ * GBASetActiveRegion's slow path. */
+static inline bool GBAJumpFast(struct ARMCore* cpu, uint32_t address) {
+	struct GBA* gba = (struct GBA*) cpu->master;
+	struct GBAMemory* memory = &gba->memory;
+	int newRegion = address >> BASE_OFFSET;
+	if (gba->idleOptimization < IDLE_LOOP_DETECT && newRegion == memory->activeRegion &&
+	    (gba->idleOptimization < IDLE_LOOP_REMOVE || newRegion == GBA_REGION_BIOS || address != gba->idleLoop) &&
+	    (newRegion < GBA_REGION_ROM0 || (address & (GBA_SIZE_ROM0 - 1)) < memory->romSize)) {
+		gba->lastJump = address;
+		memory->lastPrefetchedPc = 0;
+		if (cpu->cpsr.t) {
+			cpu->memory.activeMask |= WORD_SIZE_THUMB;
+		} else {
+			cpu->memory.activeMask &= -WORD_SIZE_ARM;
+		}
+		return true;
+	}
+	return false;
+}
+
 CXX_GUARD_END
 
 #endif
