+/* The debugger's memory shim replaces setActiveRegion, so only builds without debuggers skip the call. */
+static inline void _armSetActiveRegion(struct ARMCore* cpu, uint32_t pc) {
+#if defined(M_CORE_GBA) && !defined(ENABLE_DEBUGGERS)
+	if (GBAJumpFast(cpu, pc)) {
