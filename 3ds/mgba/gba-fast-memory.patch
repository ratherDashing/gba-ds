+/* The usual jump (same region, no idle loop to check) takes a short path; the rest is _setActiveRegionSlow. */
+static void GBASetActiveRegion(struct ARMCore* cpu, uint32_t address) {
+	struct GBA* gba = (struct GBA*) cpu->master;
+	struct GBAMemory* memory = &gba->memory;
+	int newRegion = address >> BASE_OFFSET;
+	if (gba->idleOptimization < IDLE_LOOP_DETECT && newRegion == memory->activeRegion &&
+	    (gba->idleOptimization < IDLE_LOOP_REMOVE || newRegion == GBA_REGION_BIOS || address != gba->idleLoop) &&
+	    (newRegion < GBA_REGION_ROM0 || (address & (GBA_SIZE_ROM0 - 1)) < memory->romSize)) {
+		gba->lastJump = address;
+		memory->lastPrefetchedPc = 0;
+		if (cpu->cpsr.t) {
+			cpu->memory.activeMask |= WORD_SIZE_THUMB;
+		} else {
+			cpu->memory.activeMask &= -WORD_SIZE_ARM;
+		}
+		return;
+	}
+	_setActiveRegionSlow(cpu, address);
+}
