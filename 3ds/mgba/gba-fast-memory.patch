+/* GBAMemoryStall without its loop: when the wait is no longer than one sequential ROM fetch (the usual RAM, I/O and video
+ * accesses) the loop never runs, and the answer is the same fixed number whatever the wait was. */
+static inline int32_t _stall(struct ARMCore* cpu, struct GBAMemory* memory, int32_t wait) {
+	int32_t s = cpu->memory.activeSeqCycles16;
+	if (wait <= s + 1) {
+		uint32_t dist = memory->lastPrefetchedPc - cpu->gprs[ARM_PC];
+		memory->lastPrefetchedPc = cpu->gprs[ARM_PC] + (dist < 16 ? dist & ~1U : 0);
+		return s - cpu->memory.activeNonseqCycles16;
+	}
+	return GBAMemoryStall(cpu, wait);
+}
+
+/* The fast paths below end in these when the CPU runs from ROM with the prefetch buffer on: they stay out of line so a
+ * fast path needs no stack frame. */
+static __attribute__((noinline)) uint32_t _stalledLoad(struct ARMCore* cpu, int32_t wait, int* cycleCounter, uint32_t value) {
+	*cycleCounter += _stall(cpu, &((struct GBA*) cpu->master)->memory, wait);
+	return value;
+}
