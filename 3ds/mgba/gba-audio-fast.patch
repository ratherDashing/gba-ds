+/* memset(samples, value, GBA_MAX_SAMPLES) as four word stores: no library call per event. */
+static inline void _fillSamples(int8_t* samples, int8_t value) {
+	uint32_t word = (uint8_t) value * 0x01010101U;
+	memcpy(samples, &word, 4);
+	memcpy(samples + 4, &word, 4);
+	memcpy(samples + 8, &word, 4);
+	memcpy(samples + 12, &word, 4);
+}
+
